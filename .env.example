FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_do_not_commit
FEISHU_SPREADSHEET_TOKEN=shtcn_xxxxxxxxxxxxx
# Sheets: use Sheet1!A1. Bitable/Base: use table_id like tblxxxxxxxx.
FEISHU_SHEET_RANGE=Sheet1!A1
# Optional for Bitable/Base attachment upload. If FEISHU_SPREADSHEET_TOKEN is a wiki/cloud-document node token,
# set the real bitable app_token here, or let the app query it automatically.
FEISHU_BITABLE_APP_TOKEN=
# Optional. If omitted, the app uses FEISHU_APP_ID + FEISHU_APP_SECRET to fetch tenant_access_token.
FEISHU_ACCESS_TOKEN=

# Production runtime safety.
# Keep production state out of macOS temp folders so refresh/restart/tests do not wipe predictions or human_gold.
PUZZLEOPS_PRODUCTION_MODE=true
PUZZLEOPS_RUNTIME_DIR=<puzzleops-runtime>
# Day-one production write scope. Other login countries remain visible but read-only.
PUZZLEOPS_WRITE_COUNTRIES=日本,法国

# Required for real multimodal semantic parsing.
VISION_LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_TIMEOUT_SECONDS=60
QWEN_FOREGROUND_WAIT_SECONDS=30
# Optional OpenAI fallback, only used when VISION_LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_DETAIL=low

# Optional for real good-image derivative generation.
# Leave empty/disabled to keep derive mode as analysis-only.
# Use mock only for local Harness UI tests; mock images are never synced as Feishu attachments.
# Use dashscope for reference-image generation; QWEN_API_KEY is reused when IMAGE_GENERATION_API_KEY is empty.
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=wan2.6-image

# Optional Qwen3-VL multimodal image embedding for visual history similarity.
# Disabled by default to avoid paid calls during local page refresh/tests.
VISUAL_EMBEDDING_ENABLE_REMOTE_CALLS=false
VISUAL_EMBEDDING_PROVIDER=qwen
VISUAL_EMBEDDING_MODEL=qwen3-vl-embedding
VISUAL_EMBEDDING_API_KEY=
VISUAL_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
VISUAL_EMBEDDING_LOCAL_DIMENSION=64
VISUAL_MILVUS_ENABLE_REMOTE_CALLS=false
VISUAL_MILVUS_URI=
VISUAL_MILVUS_COLLECTION=puzzleops_image_embeddings
VISUAL_MILVUS_TOKEN=

# Optional Agent Harness gold dataset CSV.
# Use this for 30-50 real puzzle samples with human labels; see docs/harness_gold_samples_template.csv.
PUZZLEOPS_HARNESS_DATASET=

# Optional industrial RAG providers. Remote calls only happen when explicitly enabled.
RAG_ENABLE_REMOTE_CALLS=false
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_RERANK_PROVIDER=dashscope
RAG_RERANK_MODEL=qwen3-rerank
RAG_VECTOR_STORE_PROVIDER=milvus
RAG_VECTOR_STORE_SEARCH_ENABLED=true
RAG_MILVUS_SEARCH_ENABLED=true
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=puzzle_ops_rag
MILVUS_TOKEN=

# Planned FastAPI service layer for a 6-person operations team.
# Format: user_id:token:role:countries. Separate users with commas.
# Roles: viewer, operator, admin. Countries can be 日本, 法国, or 日本|法国.
PUZZLEOPS_API_TOKENS=ops_jp:replace_me_operator_token:operator:日本,ops_fr:replace_me_operator_token:operator:法国,admin:replace_me_admin_token:admin:日本|法国

FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_do_not_commit
FEISHU_SPREADSHEET_TOKEN=shtcn_xxxxxxxxxxxxx
# Sheets: use Sheet1!A1. Bitable/Base: use table_id like tblxxxxxxxx.
FEISHU_SHEET_RANGE=Sheet1!A1
# Optional for Bitable/Base attachment upload. If FEISHU_SPREADSHEET_TOKEN is a wiki/cloud-document node token,
# set the real bitable app_token here, or let the app query it automatically.
FEISHU_BITABLE_APP_TOKEN=
# Optional. If omitted, the app uses FEISHU_APP_ID + FEISHU_APP_SECRET to fetch tenant_access_token.
FEISHU_ACCESS_TOKEN=

# Required for real multimodal semantic parsing.
VISION_LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen3-vl-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Optional OpenAI fallback, only used when VISION_LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_DETAIL=low
